{
  "name": "imagine-booth-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "imagine booth guest gallery + delivery backend (Cloudflare Worker, or plain node)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "esbuild dev-server.ts --bundle --platform=node --format=esm --packages=external --outfile=.dev/dev-server.mjs --log-level=warning && node .dev/dev-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute imagine-booth --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute imagine-booth --local --file=schema.sql"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
